# AA-X17 pre-commit gate. Skip via HUSKY=0 env or git commit --no-verify.
#
# Runs eslint on staged src/ files only — mirrors `npm run lint` (which is
# what CI runs). tests/ is intentionally excluded: the typed rule
# `@typescript-eslint/no-floating-promises` requires parserOptions.project
# coverage that the test-file globs don't have, and CI doesn't lint tests
# either (see eslint.config.js — only src/server, src/client, src/lib,
# etc. carry typed-parser options).
#
# Heavy checks (full test suite, tsc --build) run in CI to keep the
# commit cycle snappy.

STAGED_TS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^src/.*\.(ts|tsx)$' || true)

if [ -n "$STAGED_TS" ]; then
  echo "==> [husky] eslint on staged src/ files..."
  npx --no-install eslint $STAGED_TS || {
    echo "==> [husky] eslint failed — commit aborted."
    echo "==> [husky] override: HUSKY=0 git commit ...  OR  git commit --no-verify"
    exit 1
  }
fi
