    "json5": "^2.2.3",
    "lucide-react": "^1.14.0",
    "mustache": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@devvit/start": "^0.12.23",
    "@devvit/web": "^0.12.23",
    "@eslint/js": "9.39.2",
    "@types/mustache": "^4.2.5",
    "@types/node": "^22.19.7",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.0",
    "devvit": "^0.12.23",
    "eslint": "9.39.2",
