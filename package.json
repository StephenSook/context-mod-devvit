{
  "private": true,
  "name": "cm-devvit",
  "version": "0.6.7",
  "description": "Devvit Web port of FoxxMD's ContextMod rule-engine moderation bot",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "deploy": "npm run type-check && npm run lint && npm run test && devvit upload",
    "dev": "devvit playtest",
    "dev:web": "vite build && node scripts/dev/mock-server.cjs",
    "launch": "npm run deploy && devvit publish",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs --output-type err",
    "deps:graph": "depcruise src --config .dependency-cruiser.cjs --output-type dot | dot -T svg > docs/deps-graph.svg",
    "login": "devvit login",
    "prettier": "prettier --write .",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:shard": "vitest run --config vitest.config.ts --shard=$SHARD",
    "type-check": "tsc --build",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.2.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.3",
    "ajv": "^8.17.1",
    "blockhash-core": "^0.1.0",
    "hono": "^4.12.21",
    "jpeg-js": "^0.4.4",
    "json5": "^2.2.3",
    "lucide-react": "^1.16.0",
    "mustache": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "safe-regex": "^2.1.1",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@devvit/start": "0.12.23",
    "@devvit/web": "0.12.24",
    "@eslint/js": "9.39.2",
    "@playwright/test": "^1.60.0",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/mustache": "^4.2.5",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/safe-regex": "^1.1.6",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.5.0",
    "dependency-cruiser": "^17.4.0",
    "devvit": "0.12.23",
    "eslint": "9.39.2",
    "fast-check": "^4.8.0",
    "globals": "17.6.0",
    "husky": "^9.1.7",
    "js-yaml": "^4.1.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.14",
    "prettier": "3.8.3",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "7.3.1",
    "vitest": "^2.1.9"
  }
}
